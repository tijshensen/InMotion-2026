# Local SQLite
DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# SpaceXAI / xAI — required for Import from URL on /admin/sites
# https://console.x.ai
XAI_API_KEY=""
# XAI_MODEL="grok-4.5"

# --- Railway production ---
# Attach a volume mounted at /data, then:
# DATA_DIR=/data
# DATABASE_URL=file:/data/prisma/prod.db
# AUTH_SECRET=<openssl rand -base64 32>
# XAI_API_KEY=<your key>
# Optional first-boot admin (otherwise a random password is printed in logs):
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password

# Cloudflare Pages — Publish deploys generated sites to <project>.pages.dev
# Token: dash.cloudflare.com → My Profile → API Tokens
#   Permission: Account → Cloudflare Pages → Edit
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# TransIP — optional. Lets Publish apply CNAME or Cloudflare nameservers
# automatically. Control panel → Profile → API → generate key pair.
# TRANSIP_LOGIN=
# TRANSIP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

